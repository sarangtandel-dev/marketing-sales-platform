#!/bin/sh
# Blocks commits that contain credentials (ADR-0016, issue 19 #2).
# Installed by `pnpm install` (git config core.hooksPath .githooks).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the secrets scan can't run." >&2
  echo "Install it (macOS: brew install gitleaks) and commit again." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
