{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "tooling": {
      "entry": [
        "*.ts",
        "unlighthouse.config.mjs"
      ]
    },
    "packages/form-worker": {
      "entry": [
        "scripts/*.ts"
      ]
    },
    "packages/site-builder": {
      "entry": [
        "app/pages/**/*.{astro,ts}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "@msp/tracking",
        "msp",
        "sharp"
      ]
    }
  },
  "ignore": [
    ".agents/**",
    "templates/**"
  ],
  "ignoreBinaries": [
    "gitleaks"
  ]
}
