{
  "name": "marketing-sales-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "secrets:scan": "gitleaks git --redact --no-banner .",
    "build:site": "node packages/site-builder/src/cli.ts",
    "check:launch": "node tooling/launch-check.ts",
    "forms:manifest": "node packages/site-builder/src/manifest-cli.ts clients/client-zero/site packages/form-worker/src/forms.generated.json"
  },
  "devDependencies": {
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
