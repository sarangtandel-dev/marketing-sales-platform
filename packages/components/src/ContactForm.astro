---
// Contact form section. Variant: "stacked" (one field per row).
// Its browser behaviour is in contact-form.client.ts.
interface Props {
  variant: "stacked";
  level: 1 | 2;
  text: { heading: string; body?: string };
  form?: {
    id: string;
    formType: string;
    endpoint: string;
    siteKey: string;
    language: string;
    fields: {
      name: string;
      type: "text" | "email" | "tel" | "textarea" | "select";
      label: string;
      required: boolean;
      autocomplete?: string;
      options?: { value: string; label: string }[];
    }[];
    optIns: { channel: string; version: string; label: string }[];
    submit: string;
    success: string;
    error: string;
    privacyHref: string;
    privacyNotice: string;
  };
}

const { level, text, form } = Astro.props;
const Heading = `h${level}`;
if (!form) throw new Error("contact-form section needs a form");
const fieldId = (name: string) => `${form.id}-${name}`;
---
<section class="px-4 py-section">
  <div class="mx-auto max-w-xl">
    <Heading class="font-heading text-3xl">{text.heading}</Heading>
    {text.body && <p class="mt-3 text-muted">{text.body}</p>}

    <form
      class="mt-8 grid gap-5"
      method="post"
      action={form.endpoint}
      data-msp-form
      data-form-id={form.id}
      data-form-type={form.formType}
      data-language={form.language}
      data-success={form.success}
      data-error={form.error}
    >
      {form.fields.map((field) => (
        <div class="grid gap-1.5">
          <label class="font-medium" for={fieldId(field.name)}>{field.label}</label>
          {field.type === "textarea" ? (
            <textarea
              class="rounded-card border border-on-surface/20 bg-surface px-3 py-2"
              id={fieldId(field.name)}
              name={field.name}
              rows="5"
              required={field.required}
              maxlength="5000"
            />
          ) : field.type === "select" ? (
            <select
              class="rounded-card border border-on-surface/20 bg-surface px-3 py-2"
              id={fieldId(field.name)}
              name={field.name}
              required={field.required}
            >
              <option value="" />
              {field.options?.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          ) : (
            <input
              class="rounded-card border border-on-surface/20 bg-surface px-3 py-2"
              id={fieldId(field.name)}
              name={field.name}
              type={field.type}
              required={field.required}
              autocomplete={field.autocomplete}
              maxlength="500"
            />
          )}
        </div>
      ))}

      {form.optIns.map((optIn) => (
        <label class="flex items-start gap-3 text-sm">
          <input
            class="mt-1"
            type="checkbox"
            name={`opt_in_${optIn.channel}`}
            data-opt-in-channel={optIn.channel}
            data-opt-in-version={optIn.version}
          />
          <span>{optIn.label}</span>
        </label>
      ))}

      <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
        <label for={fieldId("website")}>Website</label>
        <input id={fieldId("website")} name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <!-- interaction-only: the check runs unseen and shows a box only when a person must act,
           so the form doesn't shift or wait on the widget. -->
      <div class="cf-turnstile" data-sitekey={form.siteKey} data-appearance="interaction-only"></div>

      <div class="flex flex-wrap items-center gap-4">
        <button
          class="rounded-card bg-primary px-6 py-3 font-medium text-on-primary shadow-card disabled:opacity-60"
          type="submit"
        >
          {form.submit}
        </button>
        <a class="text-sm text-muted underline" href={form.privacyHref}>{form.privacyNotice}</a>
      </div>

      <p class="text-sm" role="status" aria-live="polite" data-form-status></p>
    </form>
  </div>
</section>

<!-- No SRI hash: Cloudflare updates api.js in place and requires loading it from their domain. -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { wireContactForm } from "./contact-form.client.ts";

  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-msp-form]")) wireContactForm(form, window);
</script>
