---
// FAQs. Variants: "accordion" (native <details>, works without JavaScript) and "list".
import type { HeadingLevel, Item } from "./catalog.ts";

interface Props {
  variant: "accordion" | "list";
  level: HeadingLevel;
  text: { heading: string };
  items: Item[];
}

const { variant, level, text, items } = Astro.props;
const Heading = `h${level}`;
const ItemHeading = `h${level + 1}`;
---
<section class="px-4 py-section">
  <div class="mx-auto max-w-3xl">
    <Heading class="font-heading text-3xl">{text.heading}</Heading>
    {variant === "accordion" ? (
      <div class="mt-8 divide-y divide-on-surface/10">
        {items.map((item) => (
          <details class="group py-4">
            <summary class="cursor-pointer font-medium">{item.text.question}</summary>
            <p class="mt-3 text-muted">{item.text.answer}</p>
          </details>
        ))}
      </div>
    ) : (
      <dl class="mt-8 grid gap-6">
        {items.map((item) => (
          <div>
            <dt><ItemHeading class="font-heading text-xl">{item.text.question}</ItemHeading></dt>
            <dd class="mt-2 text-muted">{item.text.answer}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>
