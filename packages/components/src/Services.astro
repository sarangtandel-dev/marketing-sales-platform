---
// Services. Variants: "grid" (cards) and "list" (one per row). An item can link to its page.
import CtaLinks from "./CtaLinks.astro";
import type { Cta, HeadingLevel, Item } from "./catalog.ts";

interface Props {
  variant: "grid" | "list";
  level: HeadingLevel;
  text: { heading: string; body?: string };
  items: Item[];
  ctas: Cta[];
}

const { variant, level, text, items, ctas } = Astro.props;
const Heading = `h${level}`;
const ItemHeading = `h${level + 1}`;
---
<section class="px-4 py-section">
  <div class="mx-auto max-w-5xl">
    <Heading class="font-heading text-3xl">{text.heading}</Heading>
    {text.body && <p class="mt-3 max-w-3xl text-muted">{text.body}</p>}
    <ul class:list={["mt-10 grid gap-6", variant === "grid" ? "md:grid-cols-3" : "md:grid-cols-1"]}>
      {items.map((item) => (
        <li class:list={["rounded-card p-6", variant === "grid" ? "bg-surface shadow-card" : "border-b border-on-surface/10"]}>
          <ItemHeading class="font-heading text-xl">
            {item.href ? <a class="hover:text-primary" href={item.href}>{item.text.title}</a> : item.text.title}
          </ItemHeading>
          <p class="mt-2 text-muted">{item.text.body}</p>
        </li>
      ))}
    </ul>
    <CtaLinks ctas={ctas} />
  </div>
</section>
