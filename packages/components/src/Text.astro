---
// Running text, e.g. an about page or the privacy policy. Variants: "prose" (one column)
// and "two-column" (block titles beside their text). A blank line in a body starts a paragraph.
import CtaLinks from "./CtaLinks.astro";
import type { Cta, HeadingLevel, Item } from "./catalog.ts";

interface Props {
  variant: "prose" | "two-column";
  level: HeadingLevel;
  text: { heading: string; intro?: string };
  items: Item[];
  ctas: Cta[];
}

const { variant, level, text, items, ctas } = Astro.props;
const Heading = `h${level}`;
const ItemHeading = `h${level + 1}`;
const paragraphs = (body: string) => body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---
<section class="px-4 py-section">
  <div class:list={["mx-auto", variant === "prose" ? "max-w-3xl" : "max-w-5xl"]}>
    <Heading class="font-heading text-3xl">{text.heading}</Heading>
    {text.intro && <p class="mt-4 text-lg text-muted">{text.intro}</p>}
    {items.map((item) => (
      <div class:list={["mt-8", variant === "two-column" && "grid gap-4 md:grid-cols-3"]}>
        {item.text.title && <ItemHeading class="font-heading text-xl">{item.text.title}</ItemHeading>}
        <div class:list={["grid gap-4", variant === "two-column" && "md:col-span-2", item.text.title && variant === "prose" && "mt-3"]}>
          {paragraphs(item.text.body).map((p) => <p>{p}</p>)}
        </div>
      </div>
    ))}
    <CtaLinks ctas={ctas} />
  </div>
</section>
