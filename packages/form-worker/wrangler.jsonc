{
  // The form Worker (ADR-0013). One Worker serves every Client's forms; each Client's
  // Lead Log is its own D1 database once there's more than Client #0 (M1).
  "name": "msp-form-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Production is served only on the Client's own route (set at launch, ticket 36); the
  // workers.dev address stays off so nothing can bypass the zone's rules (audit security M1).
  "workers_dev": false,
  // Logs and traces for incidents (Workers Logs; see docs/procedures/incident.md).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Per-IP limit on /lead (audit security M1). Generous for real Visitors; slows floods.
  "ratelimits": [{ "name": "LEAD_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // Brevo retries every 5 minutes; the 90-day Lead Log purge daily (ADR-0013).
  // Must match src/schedules.ts.
  "triggers": { "crons": ["*/5 * * * *", "17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "LEAD_LOG",
      "database_name": "lead-log-client-zero",
      // Set when the database is created in Cloudflare (with a location hint near India, ADR-0029).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // The owner alert (ADR-0013). ALERT_TO must be a verified Email Routing destination
  // address before launch; ALERT_FROM must be on a domain with Email Routing enabled.
  "send_email": [{ "name": "OWNER_ALERT", "destination_address": "owner@example.com" }],
  "vars": {
    "CLIENT_SLUG": "client-zero",
    "ALLOWED_ORIGINS": "https://client-zero.pages.dev",
    "ALERT_FROM": "alerts@example.com",
    "ALERT_TO": "owner@example.com",
    // The daily test Lead's address (ADR-0037): one we own, deleted from Brevo after each check.
    "MONITOR_TEST_EMAIL": "monitor@example.com"
  },
  // Secrets (wrangler secret put): TURNSTILE_SECRET_KEY, BREVO_API_KEY, MONITOR_SECRET,
  // HEARTBEAT_URL (the healthchecks.io ping URL; daily, with a few hours' grace) and
  // NTFY_URL (a hard-to-guess ntfy topic URL for alert pushes).
  // Optional vars: BREVO_MARKETING_LIST_ID, BREVO_DOI_TEMPLATE_ID, BREVO_DOI_REDIRECT_URL.
  // The preview Worker, for branch previews (the Deploy workflow points preview builds at it
  // through the PREVIEW_FORM_ENDPOINT repository variable). Its own Lead Log, so QA Leads
  // never mix with real ones; set its TURNSTILE_SECRET_KEY to Turnstile's test secret.
  "env": {
    "preview": {
      "name": "msp-form-worker-preview",
      // The preview Worker lives on workers.dev (no custom route) and is rate limited.
      "workers_dev": true,
      "ratelimits": [{ "name": "LEAD_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
      "d1_databases": [
        {
          "binding": "LEAD_LOG",
          "database_name": "lead-log-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [{ "name": "OWNER_ALERT", "destination_address": "qa@example.com" }],
      // No BREVO_API_KEY here: QA Leads are stored and alerted, never delivered (audit security H1).
      "vars": {
        "CLIENT_SLUG": "client-zero",
        // Turnstile's test secret reports example.com for every token, so the check is off here only.
        "TURNSTILE_SKIP_HOSTNAME": "true",
        // Anyone can post to the preview (it has only Turnstile's test secret), so its alerts
        // are marked and go to a QA inbox, never the owner's; and it has no NTFY_URL.
        "ALERT_SUBJECT_PREFIX": "[PREVIEW]",
        "ALLOWED_ORIGINS": "https://client-zero.pages.dev,https://*.client-zero.pages.dev",
        "ALERT_FROM": "alerts@example.com",
        "ALERT_TO": "qa@example.com",
        "MONITOR_TEST_EMAIL": "monitor@example.com"
      }
    }
  }
}
