{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://msp.local/schema/facts.schema.json",
  "title": "A Client's facts file (M0: one file per Client; ADR-0007, ADR-0024)",
  "type": "object",
  "required": ["facts"],
  "additionalProperties": false,
  "properties": {
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
    "fact": {
      "type": "object",
      "required": ["id", "kind", "value", "source", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable and never reused (ADR-0024).",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "description": "What the Fact is about. In M1 it decides whether the Fact is a High-risk Claim or Time-sensitive.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "value": {
          "description": "Text is keyed by language (ADR-0004); numbers, booleans and plain strings (phone numbers, URLs) are not.",
          "anyOf": [
            { "type": ["string", "number", "boolean"] },
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/language" },
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "source": {
          "type": "object",
          "required": ["type", "date"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["person", "url", "document"] },
            "who": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https?://" },
            "document": { "type": "string", "minLength": 1 },
            "date": { "$ref": "#/$defs/date" }
          },
          "allOf": [
            { "if": { "properties": { "type": { "const": "person" } } }, "then": { "required": ["who"] } },
            { "if": { "properties": { "type": { "const": "url" } } }, "then": { "required": ["url"] } },
            { "if": { "properties": { "type": { "const": "document" } } }, "then": { "required": ["document"] } }
          ]
        },
        "status": { "enum": ["client-stated", "publicly-verified", "document-verified", "unverified", "rejected"] },
        "verified_by": { "type": "string", "minLength": 1 },
        "verified_at": { "$ref": "#/$defs/date" },
        "refresh_by": { "$ref": "#/$defs/date" }
      }
    }
  }
}
