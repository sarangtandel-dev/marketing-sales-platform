---
import "msp:theme.css";
import type { Page } from "../../src/definition.ts";
import { pageById, pagePath, site, t } from "../lib/site";

interface Props {
  page: Page;
  lang: string;
  canonical?: boolean;
}

const { page, lang, canonical = true } = Astro.props;
const url = new URL(pagePath(page, lang), site.meta.site_url).href;
const { consent_tool: consentTool, gtm } = site.tracking;
const consentToolSrc =
  consentTool?.provider === "cookieyes" ? `https://cdn-cookieyes.com/client_data/${consentTool.id}/script.js` : undefined;
// Read by the tracking script, which loads GTM only after analytics consent.
// "<" is escaped so the value can never close the script element.
const trackingConfig = `window.mspConfig = ${JSON.stringify({ gtm: gtm ?? null }).replace(/</g, "\\u003c")};`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Consent Mode defaults: everything denied until the consent tool says otherwise (ADR-0020). Must run first. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 500,
      });
    </script>
    <script is:inline set:html={trackingConfig} />
    {consentToolSrc && <script is:inline id="cookieyes" src={consentToolSrc}></script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(page.seo.title, lang)}</title>
    <meta name="description" content={t(page.seo.description, lang)} />
    {canonical && <link rel="canonical" href={url} />}
  </head>
  <body class="bg-surface text-on-surface font-body antialiased">
    <header class="border-b border-on-surface/10 px-4">
      <nav class="mx-auto flex max-w-5xl flex-wrap gap-x-6 gap-y-2 py-4">
        {site.navigation.map((item) => (
          <a class="hover:text-primary" href={pagePath(pageById(item.page), lang)}>{t(item.label, lang)}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="px-4 py-8 text-sm text-muted">
      <div class="mx-auto max-w-5xl">{t(site.footer.text, lang)}</div>
    </footer>
    <script>
      import "@msp/tracking";
    </script>
  </body>
</html>
