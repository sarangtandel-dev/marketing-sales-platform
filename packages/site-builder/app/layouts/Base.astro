---
import "msp:theme.css";
import type { Page } from "../../src/definition.ts";
import { Font } from "astro:assets";
import { settings } from "virtual:msp/site";
import { jsonLd, jsonLdScript } from "../../src/jsonld.ts";
import { homePathFor, hreflangLinks } from "../../src/seo.ts";
import { fontVariable } from "../../src/theme-css.ts";
import { pageById, pagePath, site, t } from "../lib/site";

interface Props {
  page: Page;
  lang: string;
  canonical?: boolean;
}

const { page, lang, canonical = true } = Astro.props;
const url = new URL(pagePath(page, lang), site.meta.site_url).href;
const title = t(page.seo.title, lang);
const description = t(page.seo.description, lang);
const siteName = site.meta.name && t(site.meta.name, lang);
const ogImage = settings.ogImage && new URL(`/${settings.ogImage}`, site.meta.site_url).href;
const structuredData = canonical ? jsonLdScript(jsonLd(site, page, lang, { logo: settings.logo && `/${settings.logo}` })) : "";
const alternates = canonical ? hreflangLinks(page, site.meta.languages, site.meta.default_language, site.meta.site_url) : [];
const { consent_tool: consentTool, gtm } = site.tracking;
const consentToolSrc =
  consentTool?.provider === "cookieyes" ? `https://cdn-cookieyes.com/client_data/${consentTool.id}/script.js` : undefined;
// Read by the tracking script, which loads GTM only after analytics consent.
// "<" is escaped so the value can never close the script element.
const trackingConfig = `window.mspConfig = ${JSON.stringify({ gtm: gtm ?? null }).replace(/</g, "\\u003c")};`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Consent Mode defaults: everything denied until the consent tool says otherwise (ADR-0020). Must run first. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 500,
      });
    </script>
    <script is:inline set:html={trackingConfig} />
    {consentToolSrc && <script is:inline id="cookieyes" src={consentToolSrc}></script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {settings.favicon && <link rel="icon" href={`/${settings.favicon}`} />}
    {settings.fonts.map((token) => <Font cssVariable={fontVariable(token) as never} preload />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={url} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="theme-color" content={settings.themeColor} />
    <!-- Social previews (Open Graph, X/Twitter). -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {siteName && <meta property="og:site_name" content={siteName} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
  </head>
  <body class="bg-surface text-on-surface font-body antialiased">
    <header class="border-b border-on-surface/10 px-4">
      <nav class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 py-4">
        {settings.logo && (
          <a href={homePathFor(lang, site.meta.default_language)} class="mr-auto">
            <img src={`/${settings.logo}`} alt={t(site.meta.name!, lang)} class="h-8 w-auto" />
          </a>
        )}
        {site.navigation.map((item) => (
          <a class="hover:text-primary" href={pagePath(pageById(item.page), lang)}>{t(item.label, lang)}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="px-4 py-8 text-sm text-muted">
      <div class="mx-auto flex max-w-5xl flex-wrap gap-x-6 gap-y-2">
        <span>{t(site.footer.text, lang)}</span>
        {/* CookieYes reopens its banner from any element with this class (ADR-0020: withdrawing is as easy as giving). */}
        {site.footer.cookie_settings && (
          <button type="button" class="cky-banner-element underline hover:text-primary">{t(site.footer.cookie_settings, lang)}</button>
        )}
      </div>
    </footer>
    <script>
      import "@msp/tracking";
    </script>
  </body>
</html>
