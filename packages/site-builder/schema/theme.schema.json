{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://msp.local/schema/theme.schema.json",
  "title": "Theme: a Client's design tokens (ADR-0019)",
  "type": "object",
  "required": [
    "colors",
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "colors": {
      "$ref": "#/$defs/group"
    },
    "type": {
      "$ref": "#/$defs/group"
    },
    "spacing": {
      "$ref": "#/$defs/group"
    },
    "radius": {
      "$ref": "#/$defs/group"
    },
    "shadows": {
      "$ref": "#/$defs/group"
    },
    "fonts": {
      "description": "Web fonts, self-hosted at build time, keyed by the type token they fill. The type token's own value becomes the fallback stack.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "family",
              "provider"
            ],
            "additionalProperties": false,
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "const": "fontsource"
              },
              "weights": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[1-9]00( [1-9]00)?$"
                }
              },
              "styles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "normal",
                    "italic"
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "family",
              "provider",
              "files"
            ],
            "additionalProperties": false,
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "const": "local"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "src",
                    "weight",
                    "style"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "src": {
                      "type": "string",
                      "pattern": "\\.(woff2|woff)$"
                    },
                    "weight": {
                      "type": "string",
                      "pattern": "^[1-9]00( [1-9]00)?$"
                    },
                    "style": {
                      "enum": [
                        "normal",
                        "italic"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
